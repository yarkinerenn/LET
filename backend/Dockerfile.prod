# Multi-stage production Dockerfile for backend
# Stage 1: Build stage - install dependencies and pre-download models
FROM python:3.11-slim as builder

WORKDIR /app

# Install system dependencies for PyTorch and other libraries
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Pre-download transformer models during build
# This ensures models are cached in the image and don't need to be downloaded at runtime
ENV TRANSFORMERS_CACHE=/root/.cache/huggingface
ENV HF_HOME=/root/.cache
RUN python -c "from transformers import AutoTokenizer, AutoModelForSequenceClassification, BertTokenizer, BertModel; \
    print('Pre-downloading DistilBERT...'); \
    AutoTokenizer.from_pretrained('distilbert-base-uncased-finetuned-sst-2-english'); \
    AutoModelForSequenceClassification.from_pretrained('distilbert-base-uncased-finetuned-sst-2-english'); \
    print('Pre-downloading BERT...'); \
    BertTokenizer.from_pretrained('bert-base-uncased'); \
    BertModel.from_pretrained('bert-base-uncased'); \
    print('Models pre-downloaded successfully.')"

# Stage 2: Production stage - minimal runtime image
FROM python:3.11-slim

WORKDIR /app

# Install only runtime dependencies (no build tools)
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Python dependencies from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy backend code (excluding unnecessary files via .dockerignore)
COPY . .

# Create uploads directory
RUN mkdir -p uploads

# Set transformer cache location
ENV TRANSFORMERS_CACHE=/app/.cache/transformers
ENV HF_HOME=/app/.cache

# Create cache directory
RUN mkdir -p /app/.cache

# Copy pre-downloaded models from builder stage
# Models are cached in /root/.cache/huggingface/ in builder stage
COPY --from=builder /root/.cache/huggingface /app/.cache/huggingface

# Expose port
EXPOSE 5000

# Set environment variables for production
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV FLASK_APP=app.py
ENV FLASK_DEBUG=0
ENV FLASK_ENV=production

# Install gunicorn for production WSGI server
RUN pip install --no-cache-dir gunicorn

# wsgi.py is copied with the rest of the code in COPY . . above (line 48)

# Run the application with gunicorn
# Use --log-level debug temporarily to see what's failing
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "2", "--timeout", "120", "--log-level", "info", "--access-logfile", "-", "--error-logfile", "-", "wsgi:app"]

